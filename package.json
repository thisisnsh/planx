{
  "name": "@thisisnsh/planx",
  "version": "0.14.0",
  "description": "A planning skill for Claude Code and Codex, plus a terminal interface for reviewing plans with versions, diffs, inline feedback, direct edits.",
  "keywords": [
    "claude-code",
    "codex",
    "agent",
    "plan",
    "review",
    "cli",
    "tui",
    "claude-code-skill",
    "claude-skill",
    "codex-skill",
    "ai-agent",
    "coding-agent",
    "agentic-coding",
    "planning",
    "code-review",
    "plan-review",
    "developer-tools"
  ],
  "homepage": "https://github.com/thisisnsh/planx",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisisnsh/planx.git"
  },
  "bugs": {
    "url": "https://github.com/thisisnsh/planx/issues"
  },
  "license": "MIT",
  "author": "thisisnsh",
  "type": "module",
  "bin": {
    "planx": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.js",
    "dev": "npm run build && node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check \"src/**/*.{ts,tsx}\" \"scripts/*.js\" \"test/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"scripts/*.js\" \"test/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:staging": "node scripts/release-staging.js",
    "remove:staging": "node scripts/remove-staging.js",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.2",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
